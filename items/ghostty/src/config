font-size = 13
font-family = "Maple Mono NF CN"
# font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-feature = +cv12
font-feature = +cv18
# [INFO] -> == !=
font-feature = -calt, -liga, -dlig
# font-codepoint-map = U+e000-U+e00a,U+ea60-U+ebeb,U+e0a0-U+e0c8,U+e0ca,U+e0cc-U+e0d7,U+e200-U+e2a9,U+e300-U+e3e3,U+e5fa-U+e6b1,U+e700-U+e7c5,U+ed00-U+efc1,U+f000-U+f2ff,U+f000-U+f2e0,U+f300-U+f372,U+f400-U+f533,U+f0001-U+f1af0=Symbols Nerd Font Mono
# font-codepoint-map = U+4E00-U+9FFF,U+3400-U+4DBF=Maple Mono NF CN
confirm-close-surface = false
cursor-style = block
cursor-style-blink = false
cursor-color = #f5e0dc
cursor-text  = #11111b
custom-shader = ~/.config/ghostty/shaders/cursor_blaze.glsl
term = xterm-256color
mouse-hide-while-typing = true
window-decoration = true
macos-titlebar-proxy-icon = hidden
title = " "
theme = catppuccin-mocha
shell-integration-features = no-cursor
window-padding-y = 2
window-padding-x = 3
window-height = 50
window-width = 200
window-padding-balance = true
background-opacity = 0.85

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
