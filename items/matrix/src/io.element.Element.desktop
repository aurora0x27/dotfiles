[Desktop Entry]
Name=Element-Patch
Comment=Feature-rich client for Matrix
Exec=/usr/bin/element-desktop --password-store=gnome-libsecret --proxy-server=socks5://127.0.0.1:2080 %U
Terminal=false
Type=Application
Icon=io.element.Element
StartupWMClass=Element
Categories=Network;InstantMessaging;Chat;IRCClient
MimeType=x-scheme-handler/element;x-scheme-handler/io.element.desktop;
