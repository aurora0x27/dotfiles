{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "[S]hutdown",
    "keybind" : "s"
}
{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "[L]ock",
    "keybind" : "l"
}
{
    "label" : "exit",
    "action" : "niri msg action quit --skip-confirmation",
    "text" : "[E]xit",
    "keybind" : "e"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "[R]eboot",
    "keybind" : "r"
}
