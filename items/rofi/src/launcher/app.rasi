configuration {
    modes:                      "drun";
    font:                       "Maple Mono NF CN 12";
    show-icons:                 true;
	terminal:                   "alacritty";
    icon-theme:                 "WhiteSur";
	combi-modes:                "window,drun";
    combi-hide-mode-prefix:     true;
    display-drun:               " ";
	drun-display-format:        "{name}";
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
}

@import "theme.rasi"
